<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CelesteRoot Condition="'$(CelesteRoot)' == '' and '$(CELESTE_ROOT)' != ''">$(CELESTE_ROOT)</CelesteRoot>
    <CelesteRoot Condition="'$(CelesteRoot)' == ''">C:\SteamLibrary\steamapps\common\Celeste</CelesteRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FNA"><HintPath>$(CelesteRoot)\FNA.dll</HintPath><Private>true</Private></Reference>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>
</Project>
